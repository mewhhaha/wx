{
  "name": "wx",
  "private": true,
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=22",
    "deno": ">=2.9 <3"
  },
  "scripts": {
    "bench:editor": "node scripts/benchmark-editor.mjs",
    "bench:editor:smoke": "pnpm build && node scripts/benchmark-editor.mjs --mode smoke",
    "bench:editor:full": "pnpm build && node scripts/benchmark-editor.mjs --mode full",
    "bench:compare": "node scripts/benchmark-editor.mjs --mode compare",
    "build": "pnpm -r build",
    "check": "pnpm run test:unit && pnpm run test:e2e",
    "dev": "pnpm run dev:playground",
    "dev:playground": "pnpm --filter @wx/playground dev -- --host 127.0.0.1 --port 4173",
    "deno:check": "deno task check",
    "jsr:check:editor": "bash scripts/jsr-dry-run-editor.sh",
    "test:artifacts": "node scripts/verify-package-artifacts.mjs",
    "test:bench": "node --test scripts/benchmark-helpers.test.mjs",
    "test:boundaries": "node scripts/verify-package-boundaries.mjs",
    "test:e2e:ci": "playwright test --config=playwright.config.ts --project=chromium-smoke",
    "test:e2e:chromium-smoke": "playwright test --config=playwright.config.ts --project=chromium-smoke",
    "test:e2e:dom-matrix": "playwright test --config=playwright.dom-matrix.config.ts",
    "test:e2e:dom-chromium": "playwright test --config=playwright.dom-matrix.config.ts --project=dom-chromium",
    "test:e2e:dom-firefox": "playwright test --config=playwright.dom-matrix.config.ts --project=dom-firefox",
    "test:e2e:dom-webkit": "playwright test --config=playwright.dom-matrix.config.ts --project=dom-webkit",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts",
    "test:e2e:soak": "playwright test --config=playwright.soak.config.ts",
    "test:e2e:web-lifecycle-production": "playwright test --config=playwright.web-lifecycle-production.config.ts",
    "verify:workspace": "pnpm run deno:check && pnpm build && pnpm test:exports && pnpm test:boundaries && pnpm test:artifacts && pnpm test:bench && pnpm test:unit",
    "test:exports": "node scripts/package-export-smoke.mjs",
    "test:e2e": "pnpm run test:e2e:chromium-smoke && pnpm run test:e2e:dom-matrix && pnpm run test:e2e:web-lifecycle-production",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "jsdom": "^29.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.2"
  }
}
